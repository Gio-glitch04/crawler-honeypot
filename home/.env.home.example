# Variables para el modo PC + Cloudflare Tunnel. Copiar a la raíz del
# proyecto como .env y completar.
HONEYPOT_DOMAIN=definitivamente-no-hay-trabas.com.ar
HONEYPOT_TRAP_PATH=archivo-interno

# Corta el laberinto a esta profundidad para no sobrecargar la PC (0 = sin límite).
HONEYPOT_MAX_DEPTH=10

# Token del túnel: Cloudflare > Zero Trust > Networks > Tunnels > Create a tunnel.
CLOUDFLARE_TUNNEL_TOKEN=

# Generar con: docker run --rm python:3.12-slim python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
HONEYPOT_TOKEN_SECRET=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Cuenta gratuita en https://www.maxmind.com/en/geolite2/signup
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

HOST_UID=1000
HOST_GID=1000
ANALYTICS_RUN_AT_UTC=00:30
ROBOTS_LOOKBACK_DAYS=30
