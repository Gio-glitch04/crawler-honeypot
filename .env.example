# Copiar a .env y completar. No subir .env a git.
HONEYPOT_DOMAIN=definitivamente-no-hay-trabas.com.ar

# Ruta prohibida en robots.txt (sin barras). "trap" delata el honeypot; usar
# un nombre neutro y NO cambiarlo una vez iniciado el experimento.
HONEYPOT_TRAP_PATH=archivo-interno

# Generar con: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
HONEYPOT_TOKEN_SECRET=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Cuenta gratuita en https://www.maxmind.com/en/geolite2/signup
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# UID/GID del usuario del host dueño de ./data (salida de `id -u` / `id -g`)
HOST_UID=1000
HOST_GID=1000

ANALYTICS_RUN_AT_UTC=00:30
ROBOTS_LOOKBACK_DAYS=30
